# Trota OS Server / Edge / Cloud — packages of the disk images built by
# scripts/build/build-image.sh (no graphical session, no installer).
# The kernel is chosen by the edition: generic HWE kernel and firmware for
# server/edge hardware, the smaller "virtual" kernel for cloud images.

# Base system
ubuntu-minimal
grub-pc
grub-pc-bin
grub-efi-amd64-bin
grub-efi-amd64-signed
shim-signed
efibootmgr
apparmor
unattended-upgrades
needrestart              # restarts services after library updates
ufw                      # enabled by the image build, SSH allowed
openssh-server           # keys only: password login over SSH is disabled
cloud-init               # first-boot provisioning: users, SSH keys, network, growpart
cloud-guest-utils        # growpart: the root partition grows to fill the disk
systemd-timesyncd
bash-completion
ca-certificates
curl
less
nano
htop
lsof
iproute2
iputils-ping
bind9-dnsutils
rsync
jq

# Containers (Docker-compatible CLI, rootless by default)
podman
uidmap
passt
slirp4netns
catatonit
dbus-user-session        # rootless containers need the user D-Bus session
