msgid "on"
msgstr "attivo"

#: applications/trota-common/trota_common/diagnostics.py:189
#, python-brace-format
msgid "Automatic security updates: {v}"
msgstr "Aggiornamenti di sicurezza automatici: {v}"

#: applications/trota-common/trota_common/diagnostics.py:193
msgid "APT configuration could not be read."
msgstr "Impossibile leggere la configurazione di APT."

#: applications/trota-common/trota_common/diagnostics.py:196
msgid "Firewall (ufw): enabled"
msgstr "Firewall (ufw): attivo"

#: applications/trota-common/trota_common/diagnostics.py:198
msgid "Firewall (ufw): installed, not enabled (no service listens on the network by default)"
msgstr "Firewall (ufw): installato, non attivo (per impostazione predefinita nessun servizio è in ascolto sulla rete)"

#: applications/trota-common/trota_common/diagnostics.py:199
msgid "Security features are active."
msgstr "Le funzioni di sicurezza sono attive."

#: applications/trota-common/trota_common/diagnostics.py:199
msgid "Some security features are not active."
msgstr "Alcune funzioni di sicurezza non sono attive."

#: applications/trota-common/trota_common/diagnostics.py:201
msgid "Open \"Software & Updates\" → Updates and enable automatic security updates. AppArmor should never be disabled on Trota OS."
msgstr "Apri \"Software e aggiornamenti\" → Aggiornamenti e attiva gli aggiornamenti di sicurezza automatici. AppArmor non dovrebbe mai essere disattivato su Trota OS."

#: applications/trota-common/trota_common/diagnostics.py:204
msgid "Security"
msgstr "Sicurezza"

#: applications/trota-common/trota_common/diagnostics.py:208
msgid "System services"
msgstr "Servizi di sistema"

#: applications/trota-common/trota_common/diagnostics.py:212
msgid "systemctl is not available."
msgstr "systemctl non è disponibile."

#: applications/trota-common/trota_common/diagnostics.py:214
msgid "The service manager could not be queried."
msgstr "Impossibile interrogare il gestore dei servizi."

