msgid "AppArmor: enabled"
msgstr "AppArmor: attivo"

#: applications/trota-common/trota_common/diagnostics.py:181
msgid "AppArmor: not enabled"
msgstr "AppArmor: non attivo"

#: applications/trota-common/trota_common/diagnostics.py:188
#, python-brace-format
msgid "Automatic update check: {v}"
msgstr "Controllo automatico degli aggiornamenti: {v}"

#: applications/trota-common/trota_common/diagnostics.py:188
