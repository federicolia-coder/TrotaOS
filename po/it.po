msgid "Core services are running."
msgstr "I servizi principali sono in esecuzione."

#: applications/trota-common/trota_common/diagnostics.py:245
#, python-brace-format
msgid "{n} service needs attention."
msgid_plural "{n} services need attention."
msgstr[0] "{n} servizio richiede attenzione."
msgstr[1] "{n} servizi richiedono attenzione."

#: applications/trota-common/trota_common/diagnostics.py:247
msgid "Inspect a service with: systemctl status <name>. Use \"Logs\" to read its messages."
msgstr "Esamina un servizio con: systemctl status <nome>. Usa \"Registri\" per leggerne i messaggi."

#: applications/trota-common/trota_common/diagnostics.py:252
msgid "Recent errors in the system log"
msgstr "Errori recenti nel registro di sistema"

#: applications/trota-common/trota_common/diagnostics.py:255
msgid "journalctl is not available."
msgstr "journalctl non è disponibile."

#: applications/trota-common/trota_common/diagnostics.py:257
msgid "The system log could not be read."
msgstr "Impossibile leggere il registro di sistema."

#: applications/trota-common/trota_common/diagnostics.py:262
msgid "Only your own messages are visible: members of the \"adm\" group can read the full system log."
msgstr "Sono visibili solo i tuoi messaggi: i membri del gruppo \"adm\" possono leggere l'intero registro di sistema."

#: applications/trota-common/trota_common/diagnostics.py:264
msgid "No errors logged since the last boot."
msgstr "Nessun errore registrato dall'ultimo avvio."

#: applications/trota-common/trota_common/diagnostics.py:266
#, python-brace-format
msgid "{n} error message since the last boot."
msgid_plural "{n} error messages since the last boot."
msgstr[0] "{n} messaggio di errore dall'ultimo avvio."
msgstr[1] "{n} messaggi di errore dall'ultimo avvio."

#: applications/trota-common/trota_common/diagnostics.py:269
msgid "Some errors are harmless (hardware probing, optional drivers). Open \"Logs\" for details and include them when you report a problem."
msgstr "Alcuni errori sono innocui (rilevamento hardware, driver opzionali). Apri \"Registri\" per i dettagli e allegali quando segnali un problema."

