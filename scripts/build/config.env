# Trota OS build configuration.
# Sourced by every script in scripts/build/. Values can be overridden from the
# environment, e.g.  TROTA_MIRROR=http://it.archive.ubuntu.com/ubuntu ./scripts/build/build-iso.sh

# --- Product identity -------------------------------------------------------
: "${TROTA_NAME:=Trota OS}"
: "${TROTA_VERSION:=1.0}"
: "${TROTA_CODENAME:=Fario}"          # Salmo trutta fario, brown trout
: "${TROTA_PUBLISHER:=TestardStudios}"

# --- Base system ------------------------------------------------------------
# Ubuntu 24.04 LTS "noble". See docs/architecture.md (ADR-001) for the rationale.
: "${TROTA_BASE_SUITE:=noble}"
: "${TROTA_BASE_VERSION:=24.04}"
: "${TROTA_ARCH:=amd64}"
: "${TROTA_MIRROR:=http://archive.ubuntu.com/ubuntu}"
: "${TROTA_SECURITY_MIRROR:=http://security.ubuntu.com/ubuntu}"
: "${TROTA_COMPONENTS:=main restricted universe multiverse}"

# --- Desktop ISO flavour ----------------------------------------------------
# desktop: the standard Trota OS ISO. vr: the same desktop plus the VR stack
# (packages/manifest/vr.list and the Trota VR app), see docs/editions.md.
: "${TROTA_FLAVOR:=desktop}"

# --- Image ------------------------------------------------------------------
: "${TROTA_ISO_VOLID:=TROTA_OS_1_0_AMD64}"    # max 32 chars, ISO 9660 d-characters
# xz gives the smallest image (as Ubuntu does); zstd builds ~4x faster.
: "${TROTA_SQUASHFS_COMP:=xz}"

# --- Paths (relative to the repository root) --------------------------------
: "${TROTA_BUILD_DIR:=build}"
: "${TROTA_DIST_DIR:=dist}"
: "${TROTA_LOG_DIR:=logs}"
: "${TROTA_CHECKSUM_DIR:=checksums}"
