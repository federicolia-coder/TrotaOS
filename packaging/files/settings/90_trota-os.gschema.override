# Trota OS desktop defaults (package trota-desktop-settings).
# Ubuntu's 10_ubuntu-settings.gschema.override uses session-specific sections
# (":ubuntu" for the Ubuntu session, ":GNOME-Greeter" for the login screen);
# the same keys are repeated here so that Trota OS wins in every session.
# Users can change all of these in Settings: only the defaults are set.

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/trota/trota-steel.png'
picture-uri-dark='file:///usr/share/backgrounds/trota/trota-forge.png'
picture-options='zoom'
primary-color='#101214'

[org.gnome.desktop.background:ubuntu]
picture-uri='file:///usr/share/backgrounds/trota/trota-steel.png'
picture-uri-dark='file:///usr/share/backgrounds/trota/trota-forge.png'
picture-options='zoom'
primary-color='#101214'

[org.gnome.desktop.background:GNOME-Greeter]
picture-uri='file:///usr/share/backgrounds/trota/trota-forge.png'
picture-uri-dark='file:///usr/share/backgrounds/trota/trota-forge.png'
picture-options='zoom'
primary-color='#101214'

[org.gnome.desktop.screensaver:ubuntu]
picture-uri='file:///usr/share/backgrounds/trota/trota-forge.png'
picture-options='zoom'
primary-color='#101214'

[org.gnome.desktop.interface]
color-scheme='prefer-dark'
gtk-theme='Yaru-dark'
icon-theme='Yaru-dark'
font-name='Inter 11'
document-font-name='Inter 11'
clock-show-weekday=true
show-battery-percentage=true

[org.gnome.desktop.interface:ubuntu]
color-scheme='prefer-dark'
gtk-theme='Yaru-dark'
icon-theme='Yaru-dark'
font-name='Inter 11'
document-font-name='Inter 11'
clock-show-weekday=true
show-battery-percentage=true

[org.gnome.desktop.interface:GNOME-Greeter]
color-scheme='prefer-dark'
font-name='Inter 11'

[org.gnome.login-screen]
logo='/usr/share/pixmaps/trota-logo-gdm.png'

[org.gnome.shell:ubuntu]
favorite-apps=['firefox.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'org.gnome.TextEditor.desktop', 'libreoffice-writer.desktop', 'org.gnome.Software.desktop', 'it.testardstudios.TrotaWelcome.desktop', 'yelp.desktop']

[org.gnome.shell.extensions.dash-to-dock:ubuntu]
custom-background-color=true
background-color='#101214'
transparency-mode='FIXED'
background-opacity=0.86

[org.gnome.desktop.a11y]
always-show-universal-access-status=true

[org.gnome.desktop.privacy]
report-technical-problems=false
send-software-usage-stats=false
remove-old-temp-files=true
old-files-age=uint32 30

[org.gnome.desktop.notifications]
show-in-lock-screen=false
