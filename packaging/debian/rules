#!/usr/bin/make -f
# Trota OS packaging. The source tree is assembled by
# scripts/build/build-packages.sh (repository root + packaging/debian).

export DH_VERBOSE = 1
export PYTHONDONTWRITEBYTECODE = 1

APPS := trota-common trota-welcome trota-system-info trota-diagnostics trota-package-helper
ICON_SIZES := 16 24 32 48 64 128 256 512
ART := debian/trota-artwork
SET := debian/trota-desktop-settings
SRC := debian/trota-software-sources
PYDIR := usr/lib/python3/dist-packages

%:
	dh $@ --with python3

override_dh_auto_build:
	PYTHON=python3 sh branding/render.sh build-art
	python3 scripts/build/build-docs.py docs build-docs
	set -e; for po in po/*.po; do \
		lang=$$(basename $$po .po); \
		mkdir -p build-locale/$$lang/LC_MESSAGES; \
		msgfmt --check --statistics -o build-locale/$$lang/LC_MESSAGES/trota-os.mo $$po; \
	done

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	python3 -m pytest -q -p no:cacheprovider tests --deselect tests/test_ui_smoke.py
endif

override_dh_auto_install:
	# --- trota-artwork ---------------------------------------------------
	install -d $(ART)/usr/share/backgrounds/trota $(ART)/usr/share/gnome-background-properties \
		$(ART)/usr/share/trota-os/logo $(ART)/usr/share/pixmaps \
		$(ART)/usr/share/plymouth/themes/trota $(ART)/usr/share/grub/themes/trota \
		$(ART)/usr/share/icons/hicolor/scalable/apps
	install -m 644 build-art/wallpapers/*.png branding/wallpapers/*.svg $(ART)/usr/share/backgrounds/trota/
	install -m 644 packaging/files/desktop/trota-wallpapers.xml $(ART)/usr/share/gnome-background-properties/
	install -m 644 branding/logo/*.svg $(ART)/usr/share/trota-os/logo/
	install -m 644 build-art/pixmaps/*.png $(ART)/usr/share/pixmaps/
	install -m 644 branding/themes/plymouth/trota/trota.plymouth build-art/plymouth/trota/*.png \
		$(ART)/usr/share/plymouth/themes/trota/
	install -m 644 branding/themes/grub/trota/theme.txt build-art/grub/trota/background.png \
		$(ART)/usr/share/grub/themes/trota/
	install -m 644 branding/icons/*.svg $(ART)/usr/share/icons/hicolor/scalable/apps/
	install -D -m 644 branding/icons/actions/view-app-grid-ubuntu-symbolic.svg \
		$(ART)/usr/share/icons/hicolor/scalable/actions/view-app-grid-ubuntu-symbolic.svg
	install -m 644 branding/logo/trota-symbol.svg $(ART)/usr/share/icons/hicolor/scalable/apps/trota-os-logo.svg
	install -m 644 branding/logo/trota-symbol.svg $(ART)/usr/share/icons/hicolor/scalable/apps/trota-os-logo-dark.svg
	install -m 644 branding/logo/trota-logo-light.svg $(ART)/usr/share/icons/hicolor/scalable/apps/trota-os-logo-text.svg
	install -m 644 branding/logo/trota-logo-dark.svg $(ART)/usr/share/icons/hicolor/scalable/apps/trota-os-logo-text-dark.svg
	set -e; for s in $(ICON_SIZES); do \
		install -d $(ART)/usr/share/icons/hicolor/$${s}x$${s}/apps; \
		install -m 644 build-art/icons/$${s}x$${s}/*.png $(ART)/usr/share/icons/hicolor/$${s}x$${s}/apps/; \
	done
	# --- trota-release -----------------------------------------------------
	install -D -m 644 packaging/files/release/os-release debian/trota-release/usr/lib/os-release
	install -D -m 755 packaging/files/release/05-trota-os debian/trota-release/etc/update-motd.d/05-trota-os
	install -D -m 644 packaging/files/release/51trota-unattended-upgrades \
		debian/trota-release/etc/apt/apt.conf.d/51trota-unattended-upgrades
	install -D -m 644 packaging/files/sources/trota-no-snap.pref debian/trota-release/etc/apt/preferences.d/trota-no-snap.pref
	install -D -m 644 packaging/files/sources/99trota-no-pro-ads debian/trota-release/etc/apt/apt.conf.d/99trota-no-pro-ads
	# Background queries of ubuntu-pro-client (ESM availability, APT news): masked.
	install -d debian/trota-release/etc/systemd/system
	ln -sf /dev/null debian/trota-release/etc/systemd/system/esm-cache.service
	ln -sf /dev/null debian/trota-release/etc/systemd/system/apt-news.service
	# --- trota-kiosk -------------------------------------------------------
	install -D -m 644 packaging/files/kiosk/trota-kiosk.conf debian/trota-kiosk/etc/trota-kiosk.conf
	install -D -m 755 packaging/files/kiosk/trota-kiosk-session debian/trota-kiosk/usr/lib/trota-kiosk/trota-kiosk-session
	install -D -m 644 packaging/files/kiosk/policies.json debian/trota-kiosk/etc/firefox/policies/policies.json
	install -D -m 644 packaging/files/kiosk/index.html debian/trota-kiosk/usr/share/trota-kiosk/index.html
	install -D -m 644 packaging/files/kiosk/README debian/trota-kiosk/usr/share/doc/trota-kiosk/README
	# --- trota-server-settings -------------------------------------------
	install -D -m 644 packaging/files/server/60-trota-hardening.conf \
		debian/trota-server-settings/etc/ssh/sshd_config.d/60-trota-hardening.conf
	install -D -m 644 packaging/files/server/60-trota-hardening-sysctl.conf \
		debian/trota-server-settings/usr/lib/sysctl.d/60-trota-hardening.conf
	install -D -m 644 packaging/files/server/trota-journald.conf \
		debian/trota-server-settings/usr/lib/systemd/journald.conf.d/60-trota.conf
	# --- trota-software-sources --------------------------------------------
	install -D -m 644 packaging/files/sources/mozilla.sources $(SRC)/etc/apt/sources.list.d/mozilla.sources
	install -D -m 644 packaging/files/sources/packages.mozilla.org.asc $(SRC)/usr/share/keyrings/packages.mozilla.org.asc
	install -D -m 644 packaging/files/sources/trota-mozilla.pref $(SRC)/etc/apt/preferences.d/trota-mozilla.pref
	install -D -m 644 packaging/files/sources/flathub.flatpakrepo $(SRC)/usr/share/trota-os/flathub.flatpakrepo
	# --- trota-desktop-settings ------------------------------------------
	install -D -m 644 packaging/files/settings/90_trota-os.gschema.override \
		$(SET)/usr/share/glib-2.0/schemas/90_trota-os.gschema.override
	install -D -m 644 packaging/files/settings/dconf-profile-user $(SET)/etc/dconf/profile/user
	install -D -m 644 packaging/files/settings/trota-firmware-exclude $(SET)/etc/dpkg/dpkg.cfg.d/trota-firmware-exclude
	install -D -m 644 packaging/files/settings/trota-desktop-exclude $(SET)/etc/dpkg/dpkg.cfg.d/trota-desktop-exclude
	# GDM session names (the Ubuntu files are diverted by the preinst)
	set -e; for f in packaging/files/sessions/*.desktop; do \
		n=$$(basename $$f); \
		install -D -m 644 $$f $(SET)/usr/share/$${n%%_*}/$${n#*_}; \
	done
	# No file indexer in the background (Files search still works without it)
	install -d $(SET)/etc/systemd/user
	ln -sf /dev/null $(SET)/etc/systemd/user/tracker-miner-fs-3.service
	install -D -m 644 packaging/files/settings/10-trota-terminal $(SET)/etc/dconf/db/trota.d/10-trota-terminal
	# --- Python applications ---------------------------------------------
	set -e; for app in $(APPS); do \
		mod=$$(echo $$app | tr - _); \
		install -d debian/$$app/$(PYDIR); \
		cp -r applications/$$app/$$mod debian/$$app/$(PYDIR)/; \
		find debian/$$app/$(PYDIR) -name __pycache__ -prune -exec rm -rf {} +; \
	done
	install -D -m 644 applications/trota-common/data/trota.css debian/trota-common/usr/share/trota-os/trota.css
	set -e; for lang in $$(ls build-locale); do \
		install -D -m 644 build-locale/$$lang/LC_MESSAGES/trota-os.mo \
			debian/trota-common/usr/share/locale/$$lang/LC_MESSAGES/trota-os.mo; \
	done
	set -e; for pair in welcome:TrotaWelcome system-info:TrotaSystemInfo diagnostics:TrotaDiagnostics \
			package-helper:TrotaPackageHelper; do \
		name=$${pair%%:*}; id=it.testardstudios.$${pair##*:}; \
		install -D -m 755 packaging/files/bin/trota-$$name debian/trota-$$name/usr/bin/trota-$$name; \
		install -D -m 644 packaging/files/desktop/$$id.desktop debian/trota-$$name/usr/share/applications/$$id.desktop; \
	done
	install -D -m 644 packaging/files/desktop/trota-welcome-autostart.desktop \
		debian/trota-welcome/etc/xdg/autostart/trota-welcome.desktop
	# --- ubiquity-slideshow-trota -----------------------------------------
	install -D -m 644 branding/slideshow/slideshow.conf debian/ubiquity-slideshow-trota/usr/share/ubiquity-slideshow/slideshow.conf
	install -D -m 644 branding/slideshow/slides/index.html debian/ubiquity-slideshow-trota/usr/share/ubiquity-slideshow/slides/index.html
	install -m 644 branding/logo/trota-logo-dark.svg debian/ubiquity-slideshow-trota/usr/share/ubiquity-slideshow/slides/
	install -D -m 644 packaging/files/live/trota-live-installer-icon.desktop \
		debian/ubiquity-slideshow-trota/etc/xdg/autostart/trota-live-installer-icon.desktop
	# --- trota-docs --------------------------------------------------------
	install -d debian/trota-docs/usr/share/doc/trota-docs/html
	cp -r build-docs/. debian/trota-docs/usr/share/doc/trota-docs/html/

override_dh_installsystemd:
	dh_installsystemd
	dh_installsystemd -ptrota-software-sources --name=trota-flatpak-update
	dh_installsystemd -ptrota-kiosk --name=trota-kiosk --no-start
	dh_installsystemd -ptrota-kiosk --name=trota-kiosk-restart

override_dh_python3:
	dh_python3 --no-ext-rename

override_dh_auto_clean:
	rm -rf build-art build-docs build-locale
	find . -name __pycache__ -prune -exec rm -rf {} +
