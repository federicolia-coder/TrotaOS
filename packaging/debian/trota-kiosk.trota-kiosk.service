[Unit]
Description=Trota OS Kiosk (full-screen browser on the first screen)
Documentation=file:///usr/share/doc/trota-kiosk/README
After=systemd-user-sessions.service network-online.target getty@tty1.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
EnvironmentFile=-/etc/trota-kiosk.conf
ExecStart=/usr/lib/trota-kiosk/trota-kiosk-session
# A crashed or closed browser comes back by itself.
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
